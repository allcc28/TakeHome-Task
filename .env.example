# Runtime model the agent calls while it runs (Google AI Studio, free, no card)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Search provider: brave | tavily | duckduckgo
# brave  - free tier, 1 query/sec, 2000/month
# duckduckgo - no key at all, scraped, brittle; the declared no-signup fallback
SEARCH_PROVIDER=brave
BRAVE_API_KEY=
TAVILY_API_KEY=

# Run budget
MAX_STEPS=12
